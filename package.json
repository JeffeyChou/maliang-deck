{
  "name": "maliang-deck",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Unified slide platform with JSON DSL, dual renderers (HTML + SVG), and editable PPTX export",
  "scripts": {
    "dev": "pnpm --filter @maliang-deck/cli dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages/*/src/**/*.ts",
    "serve": "node packages/cli/dist/index.js serve",
    "export": "node packages/cli/dist/index.js export",
    "validate": "node packages/cli/dist/index.js validate",
    "showcase:polish": "node scripts/showcase/polish-examples.mjs",
    "showcase:export": "node scripts/showcase/export-examples.mjs",
    "showcase:update": "node scripts/showcase/update-site.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
