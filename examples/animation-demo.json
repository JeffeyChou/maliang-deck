        {
          "type": "text",
          "id": "fx-subtitle",
          "x": 140,
          "y": 360,
          "width": 1000,
          "fontSize": 24,
          "color": "#8b949e",
          "align": "center",
          "content": "constellation + sparkle-trail — driven from DSL fx property",
          "animation": { "enter": "fade-up", "step": 0, "duration": 600, "delay": 400 }
        }
      ]
    },
