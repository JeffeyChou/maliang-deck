{
  "meta": {
    "title": "Animation Layer Demo",
    "theme": "minimal-white",
    "canvas": {
      "width": 1280,
      "height": 720
    }
  },
  "slides": [
    {
      "id": "slide-cover",
      "background": "#0d1117",
      "fx": ["gradient-blob"],
      "notes": "Cover slide demonstrating auto-play animations (step 0) with staggered timing, plus a canvas FX background.",
      "elements": [
        {
          "type": "text",
          "id": "cover-title",
          "x": 140,
          "y": 240,
          "width": 1000,
          "fontSize": 64,
          "fontFamily": "sans-serif",
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "content": "Maliang Deck Animation Layer",
          "animation": { "enter": "fade-up", "step": 0, "duration": 800 }
        },
        {
          "type": "text",
          "id": "cover-subtitle",
          "x": 140,
          "y": 340,
          "width": 1000,
          "fontSize": 28,
          "fontFamily": "sans-serif",
          "color": "#8b949e",
          "align": "center",
          "content": "Unified timeline engine · Web Animations API · Zero dependencies",
          "animation": { "enter": "fade-up", "step": 0, "duration": 600, "delay": 200 }
        }
      ]
    },
    {
      "id": "slide-autoplay",
      "background": "#ffffff",
      "notes": "Auto-play showcase: all elements at step 0 with different animation types. They stagger automatically on slide enter.",
      "elements": [
        {
          "type": "text",
          "id": "auto-title",
          "x": 80,
          "y": 40,
          "width": 600,
          "fontSize": 36,
          "fontWeight": "bold",
          "color": "#1a1a2e",
          "content": "Auto-play Animations",
          "animation": { "enter": "fade-down", "step": 0, "duration": 500 }
        },
        {
          "type": "rect",
          "id": "auto-box1",
          "x": 80,
          "y": 140,
          "width": 240,
          "height": 160,
          "fill": "#58a6ff",
          "radius": 12,
          "animation": { "enter": "fade-left", "step": 0, "duration": 600 }
        },
        {
          "type": "rect",
          "id": "auto-box2",
          "x": 360,
          "y": 140,
          "width": 240,
          "height": 160,
          "fill": "#3fb950",
          "radius": 12,
          "animation": { "enter": "scale-in", "step": 0, "duration": 600 }
        },
        {
          "type": "rect",
          "id": "auto-box3",
          "x": 640,
          "y": 140,
          "width": 240,
          "height": 160,
          "fill": "#bc8cff",
          "radius": 12,
          "animation": { "enter": "blur-in", "step": 0, "duration": 600 }
