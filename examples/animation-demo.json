        {
          "type": "rect",
          "id": "auto-box4",
          "x": 920,
          "y": 140,
          "width": 240,
          "height": 160,
          "fill": "#f0883e",
          "radius": 12,
          "animation": { "enter": "rise-in", "step": 0, "duration": 600 }
        },
        {
          "type": "text",
          "id": "auto-label1",
          "x": 80,
          "y": 320,
          "width": 240,
          "fontSize": 16,
          "color": "#666",
          "align": "center",
          "content": "fade-left",
          "animation": { "enter": "fade-up", "step": 0, "duration": 400, "delay": 400 }
        },
        {
          "type": "text",
          "id": "auto-label2",
          "x": 360,
          "y": 320,
          "width": 240,
          "fontSize": 16,
          "color": "#666",
          "align": "center",
          "content": "scale-in",
          "animation": { "enter": "fade-up", "step": 0, "duration": 400, "delay": 400 }
        },
        {
          "type": "text",
          "id": "auto-label3",
          "x": 640,
          "y": 320,
          "width": 240,
          "fontSize": 16,
          "color": "#666",
          "align": "center",
          "content": "blur-in",
          "animation": { "enter": "fade-up", "step": 0, "duration": 400, "delay": 400 }
        },
        {
          "type": "text",
          "id": "auto-label4",
          "x": 920,
          "y": 320,
          "width": 240,
          "fontSize": 16,
          "color": "#666",
          "align": "center",
          "content": "rise-in",
          "animation": { "enter": "fade-up", "step": 0, "duration": 400, "delay": 400 }
        }
      ]
    },
    {
      "id": "slide-clickstep",
      "background": "#fafafa",
      "notes": "Click-step showcase: press Right/Space to reveal each bullet point. Step 2 has two elements that animate simultaneously.",
      "elements": [
        {
          "type": "text",
          "id": "click-title",
          "x": 80,
          "y": 40,
          "width": 800,
          "fontSize": 36,
          "fontWeight": "bold",
          "color": "#1a1a2e",
          "content": "Click-to-Advance Steps",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "text",
          "id": "click-intro",
          "x": 80,
          "y": 110,
          "width": 800,
          "fontSize": 20,
          "color": "#666",
          "content": "Press → or Space to reveal each point:",
          "animation": { "enter": "fade-up", "step": 0, "delay": 200 }
        },
        {
          "type": "text",
          "id": "click-bullet1",
          "x": 120,
          "y": 200,
          "width": 800,
          "fontSize": 24,
          "color": "#1a1a2e",
          "content": "1. Schema-first: validated by Zod before runtime consumes it",
          "animation": { "enter": "fade-right", "step": 1, "duration": 500 }
        },
        {
          "type": "text",
          "id": "click-bullet2",
          "x": 120,
          "y": 270,
          "width": 800,
          "fontSize": 24,
          "color": "#1a1a2e",
          "content": "2. Zero dependencies: vanilla JS + Web Animations API",
          "animation": { "enter": "fade-right", "step": 2, "duration": 500 }
        },
        {
          "type": "rect",
          "id": "click-highlight2",
          "x": 900,
          "y": 260,
          "width": 300,
          "height": 50,
          "fill": "#dafbe1",
          "radius": 8,
          "animation": { "enter": "scale-in", "step": 2, "duration": 400 }
        },
        {
          "type": "text",
          "id": "click-bullet3",
          "x": 120,
          "y": 340,
          "width": 800,
          "fontSize": 24,
          "color": "#1a1a2e",
          "content": "3. Backwards compatible: Phase 1 decks unchanged",
          "animation": { "enter": "fade-right", "step": 3, "duration": 500 }
        },
        {
          "type": "text",
          "id": "click-bullet4",
          "x": 120,
          "y": 410,
          "width": 800,
          "fontSize": 24,
          "color": "#1a1a2e",
          "content": "4. Progressive enhancement: respects prefers-reduced-motion",
          "animation": { "enter": "fade-right", "step": 4, "duration": 500 }
        }
      ]
    },
    {
      "id": "slide-fx",
      "background": "#0d1117",
      "fx": ["constellation", "sparkle-trail"],
      "notes": "Canvas FX showcase: two FX layers (constellation + sparkle-trail) running as slide background.",
      "elements": [
        {
          "type": "text",
          "id": "fx-title",
          "x": 140,
          "y": 260,
          "width": 1000,
          "fontSize": 48,
          "fontWeight": "bold",
          "color": "#ffffff",
          "align": "center",
          "content": "Canvas FX Backgrounds",
