      "fx": ["ink-splatter"],
      "notes": "Brand manifesto — italic wave text, oversized quotation marks, glass card.",
      "elements": [
        {
          "id": "manifesto-quote-mark", "type": "text",
          "x": 48, "y": 60, "width": 200,
          "content": "\u201c", "fontSize": 280, "fontWeight": "bold", "color": "rgba(230,57,70,.08)", "lineHeight": 1,
          "animation": { "enter": "fade-up", "duration": 800, "step": 0 }
        },
        {
          "id": "manifesto-glass", "type": "rect",
          "x": 80, "y": 120, "width": 1120, "height": 400,
