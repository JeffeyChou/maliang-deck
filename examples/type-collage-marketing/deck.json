        },
        {
          "id": "manifesto-title", "type": "animatedText",
          "x": 120, "y": 158, "width": 1040,
          "content": "We believe creativity should have no boundaries. No limits. No compromises.",
          "fontSize": 36, "fontWeight": "bold", "fontStyle": "italic", "color": "#f5f0eb", "lineHeight": 1.35,
          "textAnimation": { "name": "wave", "splitMode": "word", "stagger": 80, "duration": 1600 }
        },
        {
          "id": "manifesto-attribution", "type": "text",
          "x": 120, "y": 400, "width": 760,
          "content": "Vortex Design Principles, 2026 Edition", "fontSize": 16, "color": "rgba(245,240,235,0.55)", "fontStyle": "italic",
          "animation": { "enter": "fade-up", "duration": 500, "delay": 400, "step": 0 }
        },
        {
          "id": "manifesto-accent-dot", "type": "circle",
          "x": 96, "y": 418, "radius": 5,
          "fill": "#e63946",
          "animation": { "enter": "zoom-pop", "duration": 400, "delay": 380, "step": 0 }
        },
        {
          "id": "manifesto-tagline", "type": "text",
          "x": 80, "y": 570, "width": 1120,
          "content": "DESIGN WITHOUT LIMITS", "fontSize": 60, "fontWeight": "bold", "color": "rgba(245,240,235,.07)", "align": "center",
          "animation": { "enter": "shrink-in", "duration": 900, "delay": 200, "step": 0 }
        }
      ]
    },

