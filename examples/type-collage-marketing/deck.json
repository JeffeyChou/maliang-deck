        {
          "id": "cover-kicker", "type": "text",
          "x": 108, "y": 138, "width": 580,
          "content": "INTRODUCING", "fontSize": 14, "fontWeight": "bold", "color": "#e63946",
          "animation": { "enter": "fade-up", "duration": 550, "delay": 180, "step": 0 }
        },
        {
          "id": "morph-brand", "type": "animatedText",
          "x": 100, "y": 190, "width": 620,
          "content": "VORTEX", "fontSize": 120, "fontWeight": "bold", "color": "#f5f0eb", "lineHeight": 0.9,
          "textAnimation": { "name": "stagger", "splitMode": "char", "stagger": 55, "direction": "forward", "duration": 600, "easing": "easeOutCubic" }
        },
        {
          "id": "cover-subtitle", "type": "text",
          "x": 108, "y": 450, "width": 560,
          "content": "The future of creative tools — built for designers who refuse to compromise.", "fontSize": 20, "color": "rgba(245,240,235,0.55)", "lineHeight": 1.45,
          "animation": { "enter": "blur-in", "duration": 700, "delay": 500, "step": 0 }
        },
        {
          "id": "cover-accent-bar", "type": "rect",
          "x": 108, "y": 426, "width": 420, "height": 4,
          "fill": "#e63946", "radius": 2,
          "animation": { "enter": "stretch-x", "duration": 650, "delay": 420, "step": 0 }
        }
      ]
