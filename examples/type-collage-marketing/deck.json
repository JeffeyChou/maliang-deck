{
  "meta": {
    "title": "VORTEX — Brand Launch 2026",
    "theme": "minimal-white",
    "canvas": { "width": 1280, "height": 720 },
    "htmlRuntime": {
      "transition": {
        "type": "morph",
        "durationMs": 500,
        "easing": "cubic-bezier(.2,.8,.2,1)"
      },
      "customStylesheets": ["./assets/themes/type-collage.css"],
      "customScripts": [
        "./assets/fx/kinetic-type.js",
        "./assets/fx/ink-splatter.js"
      ]
    }
  },
  "slides": [

    {
      "id": "cover",
      "background": "#0a0a0a",
      "fx": ["kinetic-type"],
      "notes": "Brand launch splash — staggered char title, morph-brand shared with CTA slide.",
      "elements": [
        {
          "id": "cover-ring-a", "type": "ellipse",
          "x": 820, "y": 60, "width": 520, "height": 520, "rotation": 15,
          "fill": "rgba(0,0,0,0)", "stroke": "rgba(230,57,70,.22)", "strokeWidth": 2,
          "animation": { "enter": "scale-in", "duration": 1000, "step": 0 }
        },
        {
          "id": "cover-ring-b", "type": "ellipse",
          "x": 876, "y": 116, "width": 410, "height": 410, "rotation": -22,
          "fill": "rgba(0,0,0,0)", "stroke": "rgba(245,240,235,.12)", "strokeWidth": 1,
          "animation": { "enter": "scale-in", "duration": 1000, "delay": 100, "step": 0 }
        },
        {
          "id": "cover-ring-c", "type": "ellipse",
          "x": 950, "y": 190, "width": 260, "height": 260, "rotation": 40,
          "fill": "rgba(0,0,0,0)", "stroke": "rgba(230,57,70,.35)", "strokeWidth": 2,
          "animation": { "enter": "scale-in", "duration": 1000, "delay": 200, "step": 0 }
        },
        {
          "id": "cover-orb", "type": "circle",
          "x": 1080, "y": 320, "radius": 100,
          "fill": "#e63946", "opacity": 0.80,
          "animation": { "enter": "zoom-pop", "duration": 900, "delay": 280, "easing": "cubic-bezier(.2,.9,.2,1)", "step": 0 }
        },
        {
          "id": "cover-deco-circle-a", "type": "circle",
          "x": 900, "y": 180, "radius": 18,
          "fill": "#2b2d42", "opacity": 0.90,
          "animation": { "enter": "scale-in", "duration": 500, "delay": 400, "step": 0 }
        },
        {
          "id": "cover-deco-circle-b", "type": "circle",
          "x": 780, "y": 540, "radius": 10,
          "fill": "#e63946", "opacity": 0.65,
          "animation": { "enter": "scale-in", "duration": 500, "delay": 500, "step": 0 }
        },
        {
          "id": "cover-glass", "type": "rect",
          "x": 60, "y": 80, "width": 680, "height": 510,
          "fill": "rgba(245,240,235,.06)", "stroke": "rgba(230,57,70,.22)", "strokeWidth": 1, "radius": 28,
          "animation": { "enter": "fade-right", "duration": 850, "step": 0 }
