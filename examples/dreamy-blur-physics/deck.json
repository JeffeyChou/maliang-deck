          "fontSize": 42,
          "fontWeight": "bold",
          "color": "#f1f5f9"
        },
        {
          "id": "schrodinger-formula-glass",
          "x": 60,
          "y": 112,
          "width": 1160,
          "height": 200,
          "animation": {
            "enter": "fade-up",
            "duration": 600,
            "delay": 160,
            "step": 0
          },
          "type": "rect",
          "fill": "rgba(196,181,253,.07)",
          "stroke": "rgba(196,181,253,.24)",
          "strokeWidth": 1,
          "radius": 22
        },
        {
          "id": "schrodinger-main-formula",
          "x": 92.21,
          "y": 126.3,
          "width": 1100,
          "height": 100,
          "animation": {
            "enter": "fade-up",
            "duration": 700,
            "delay": 260,
            "step": 0
          },
          "type": "formula",
          "latex": "i\\hbar \\frac{\\partial}{\\partial t} \\Psi(\\mathbf{r},t) = \\hat{H} \\Psi(\\mathbf{r},t)",
          "fontSize": 34,
          "color": "#f1f5f9",
          "steps": [
            {
              "latex": "i\\hbar \\frac{\\partial}{\\partial t} \\Psi = \\left[ -\\frac{\\hbar^2}{2m} \\nabla^2 + V(\\mathbf{r}) \\right] \\Psi"
            },
            {
              "latex": "\\text{For stationary states: } \\Psi(\\mathbf{r},t) = \\psi(\\mathbf{r})\\, e^{-iEt/\\hbar}"
            },
            {
              "latex": "\\hat{H} \\psi = E \\psi \\qquad \\text{(Time-independent Schrödinger equation)}"
            }
          ],
          "stepTrigger": "click"
        },
        {
          "id": "schrodinger-step-hint",
          "x": 90,
          "y": 268,
          "width": 600,
          "animation": {
            "enter": "fade-up",
            "duration": 400,
            "delay": 480,
            "step": 0
          },
          "type": "text",
          "content": "Click → to expand the derivation",
          "fontSize": 15,
          "color": "rgba(196,181,253,0.50)"
        },
        {
          "id": "schrodinger-annotation",
          "x": 80,
          "y": 370,
          "width": 1100,
          "animation": {
            "enter": "fade-up",
            "duration": 600,
            "step": 1
          },
          "type": "animatedText",
          "content": "The Hamiltonian operator Ĥ encodes the total energy of the system — kinetic plus potential.",
          "fontSize": 21,
          "color": "rgba(241,245,249,0.70)",
          "lineHeight": 1.5,
          "textAnimation": {
            "name": "blur-reveal",
            "stagger": 28,
            "duration": 700
          }
        },
        {
          "id": "schrodinger-term-psi",
          "x": 80,
          "y": 476,
          "width": 340,
          "animation": {
            "enter": "fade-up",
            "duration": 460,
            "delay": 100,
            "step": 1
          },
          "type": "text",
          "content": "Ψ(’r, t) — wave function\nencodes all quantum state information",
          "fontSize": 16,
          "color": "rgba(196,181,253,0.70)",
          "lineHeight": 1.45
        },
        {
          "id": "schrodinger-term-hbar",
          "x": 460,
          "y": 476,
          "width": 340,
          "animation": {
            "enter": "fade-up",
            "duration": 460,
            "delay": 200,
            "step": 1
          },
          "type": "text",
          "content": "ħ = h/2π — reduced Planck constant\nħ ≈ 1.055 × 10⁻³⁴ J·s",
          "fontSize": 16,
          "color": "rgba(249,168,212,0.70)",
          "lineHeight": 1.45
        },
        {
          "id": "schrodinger-term-v",
          "x": 840,
          "y": 476,
          "width": 340,
          "animation": {
            "enter": "fade-up",
            "duration": 460,
            "delay": 300,
            "step": 1
          },
          "type": "text",
          "content": "V(’r) — potential energy field\ndetermines bound state solutions",
          "fontSize": 16,
          "color": "rgba(251,191,36,0.70)",
          "lineHeight": 1.45
        },
        {
          "id": "schrodinger-orb-accent",
