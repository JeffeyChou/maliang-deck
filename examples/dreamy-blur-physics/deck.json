    {
      "id": "wave-particle",
      "background": "#0f172a",
      "fx": ["aurora-wave"],
      "notes": "Wave-particle duality: de Broglie formulas + morphing rect demonstrates wave→particle.",
      "elements": [
        {
          "id": "wp-title",
          "type": "text",
          "x": 80, "y": 42,
          "width": 760,
          "content": "Wave-Particle Duality",
          "fontSize": 42,
          "fontWeight": "bold",
          "color": "#f1f5f9",
          "animation": { "enter": "blur-in", "duration": 700, "step": 0 }
        },
        {
          "id": "wp-intro",
          "type": "text",
          "x": 80, "y": 116,
          "width": 700,
          "content": "Louis de Broglie proposed that all matter exhibits both wave-like and particle-like properties. The wavelength associated with a particle depends on its momentum.",
          "fontSize": 19,
          "color": "rgba(241,245,249,0.60)",
          "lineHeight": 1.55,
          "animation": { "enter": "fade-up", "duration": 600, "delay": 180, "step": 0 }
        },
        {
          "id": "wp-formula-glass",
          "type": "rect",
          "x": 70, "y": 300,
          "width": 780, "height": 170,
          "fill": "rgba(196,181,253,.07)",
          "stroke": "rgba(196,181,253,.22)",
          "strokeWidth": 1,
          "radius": 20,
          "animation": { "enter": "fade-up", "duration": 560, "delay": 300, "step": 0 }
        },
        {
          "id": "wp-formula-energy",
          "type": "formula",
          "x": 110, "y": 328,
          "width": 320, "height": 72,
          "latex": "E = h\\nu",
          "fontSize": 36,
          "color": "#c4b5fd",
          "animation": { "enter": "fade-up", "duration": 560, "delay": 400, "step": 0 }
        },
        {
          "id": "wp-formula-label-e",
          "type": "text",
          "x": 110, "y": 408,
          "width": 320,
          "content": "Energy-frequency relation",
          "fontSize": 14,
          "color": "rgba(196,181,253,0.55)",
          "animation": { "enter": "fade-up", "duration": 400, "delay": 460, "step": 0 }
        },
        {
          "id": "wp-formula-debroglie",
          "type": "formula",
          "x": 460, "y": 318,
          "width": 340, "height": 80,
          "latex": "\\lambda = \\frac{h}{p}",
          "fontSize": 36,
          "color": "#f9a8d4",
          "animation": { "enter": "fade-up", "duration": 560, "delay": 500, "step": 0 }
        },
        {
          "id": "wp-formula-label-l",
          "type": "text",
          "x": 460, "y": 408,
          "width": 340,
          "content": "de Broglie wavelength",
          "fontSize": 14,
          "color": "rgba(249,168,212,0.55)",
          "animation": { "enter": "fade-up", "duration": 400, "delay": 560, "step": 0 }
        },
        {
          "id": "wp-morph-label",
          "type": "text",
          "x": 920, "y": 200,
          "width": 300,
          "content": "Wave → Particle\n(click to morph)",
          "fontSize": 16,
          "color": "rgba(196,181,253,0.65)",
          "align": "center",
          "animation": { "enter": "fade-up", "duration": 400, "delay": 600, "step": 0 }
        },
        {
          "id": "wp-morph-shape",
          "type": "rect",
          "x": 890, "y": 280,
          "width": 300, "height": 30,
          "fill": "#c4b5fd",
          "radius": 4,
          "opacity": 0.85,
          "animation": { "enter": "scale-in", "duration": 600, "delay": 500, "step": 0 },
          "morphSteps": [
            { "target": { "width": 180, "height": 80, "radius": 16, "fill": "#f9a8d4" }, "duration": 700, "easing": "easeInOutCubic" },
            { "target": { "width": 80, "height": 80, "x": 950, "y": 265, "radius": 40, "fill": "#fbbf24", "opacity": 0.80 }, "duration": 650, "easing": "easeInOutCubic" }
          ],
          "morphStepTrigger": "click"
        }
      ]
    },

    {
      "id": "schrodinger",
      "background": "#0f172a",
      "notes": "Star slide: Schrödinger equation with 3-step derivation, glass card, blur-reveal annotation.",
      "elements": [
        {
          "id": "schrodinger-title",
          "type": "text",
          "x": 80, "y": 38,
          "width": 820,
          "content": "The Schrödinger Equation",
          "fontSize": 42,
          "fontWeight": "bold",
          "color": "#f1f5f9",
          "animation": { "enter": "rise-in", "duration": 700, "step": 0 }
        },
        {
          "id": "schrodinger-formula-glass",
          "type": "rect",
          "x": 60, "y": 112,
          "width": 1160, "height": 200,
          "fill": "rgba(196,181,253,.07)",
          "stroke": "rgba(196,181,253,.24)",
          "strokeWidth": 1,
          "radius": 22,
          "animation": { "enter": "fade-up", "duration": 600, "delay": 160, "step": 0 }
        },
        {
          "id": "schrodinger-main-formula",
          "type": "formula",
          "x": 90, "y": 148,
          "width": 1100, "height": 100,
          "latex": "i\\hbar \\frac{\\partial}{\\partial t} \\Psi(\\mathbf{r},t) = \\hat{H} \\Psi(\\mathbf{r},t)",
          "fontSize": 34,
          "color": "#f1f5f9",
          "steps": [
            { "latex": "i\\hbar \\frac{\\partial}{\\partial t} \\Psi = \\left[ -\\frac{\\hbar^2}{2m} \\nabla^2 + V(\\mathbf{r}) \\right] \\Psi" },
            { "latex": "\\text{For stationary states: } \\Psi(\\mathbf{r},t) = \\psi(\\mathbf{r})\\, e^{-iEt/\\hbar}" },
            { "latex": "\\hat{H} \\psi = E \\psi \\qquad \\text{(Time-independent Schr\u00f6dinger equation)}" }
          ],
          "stepTrigger": "click",
          "animation": { "enter": "fade-up", "duration": 700, "delay": 260, "step": 0 }
        },
        {
          "id": "schrodinger-step-hint",
          "type": "text",
          "x": 90, "y": 268,
          "width": 600,
          "content": "Click \u2192 to expand the derivation",
          "fontSize": 15,
          "color": "rgba(196,181,253,0.50)",
          "animation": { "enter": "fade-up", "duration": 400, "delay": 480, "step": 0 }
        },
        {
          "id": "schrodinger-annotation",
          "type": "animatedText",
          "x": 80, "y": 370,
          "width": 1100,
          "content": "The Hamiltonian operator H\u0302 encodes the total energy of the system — kinetic plus potential.",
          "fontSize": 21,
          "color": "rgba(241,245,249,0.70)",
          "lineHeight": 1.5,
          "textAnimation": { "name": "blur-reveal", "stagger": 28, "duration": 700 },
          "animation": { "enter": "fade-up", "duration": 600, "step": 1 }
        },
        {
          "id": "schrodinger-term-psi",
          "type": "text",
          "x": 80, "y": 476,
          "width": 340,
          "content": "\u03a8(\u2019r, t) — wave function\nencodes all quantum state information",
          "fontSize": 16,
          "color": "rgba(196,181,253,0.70)",
          "lineHeight": 1.45,
          "animation": { "enter": "fade-up", "duration": 460, "delay": 100, "step": 1 }
        },
        {
          "id": "schrodinger-term-hbar",
          "type": "text",
          "x": 460, "y": 476,
          "width": 340,
          "content": "\u0127 = h/2\u03c0 — reduced Planck constant\n\u0127 \u2248 1.055 \u00d7 10\u207b\u00b3\u2074 J\u00b7s",
          "fontSize": 16,
          "color": "rgba(249,168,212,0.70)",
          "lineHeight": 1.45,
          "animation": { "enter": "fade-up", "duration": 460, "delay": 200, "step": 1 }
        },
        {
          "id": "schrodinger-term-v",
          "type": "text",
          "x": 840, "y": 476,
          "width": 340,
          "content": "V(\u2019r) — potential energy field\ndetermines bound state solutions",
          "fontSize": 16,
          "color": "rgba(251,191,36,0.70)",
          "lineHeight": 1.45,
          "animation": { "enter": "fade-up", "duration": 460, "delay": 300, "step": 1 }
        },
        {
          "id": "schrodinger-orb-accent",
          "type": "circle",
          "x": 1200, "y": 80,
          "radius": 80,
          "fill": "#c4b5fd",
          "opacity": 0.10,
          "animation": { "enter": "scale-in", "duration": 800, "step": 0 }
        }
      ]
    },

    {
      "id": "probability",
      "background": "#0f172a",
      "fx": ["bokeh-float"],
      "notes": "Probability densities: two 2D graphs side-by-side with draw-on animation, plus Born rule formula.",
      "elements": [
        {
          "id": "prob-title",
          "type": "text",
          "x": 80, "y": 38,
          "width": 700,
          "content": "Probability Densities",
          "fontSize": 42,
          "fontWeight": "bold",
          "color": "#f1f5f9",
          "animation": { "enter": "fade-up", "duration": 620, "step": 0 }
        },
        {
          "id": "prob-graph-pib",
          "type": "graph",
          "x": 36, "y": 112,
          "width": 580, "height": 430,
          "functions": [
            {
              "expr": "sin(x)*sin(x)",
              "color": "#c4b5fd",
              "strokeWidth": 2.5,
              "animate": "draw-on",
              "animateDuration": 2000,
              "label": "|\u03c8\u2081|\u00b2"
            },
            {
              "expr": "sin(2*x)*sin(2*x)",
              "color": "#f9a8d4",
              "strokeWidth": 2,
              "animate": "draw-on",
              "animateDuration": 2500,
              "label": "|\u03c8\u2082|\u00b2"
            }
          ],
          "axes": { "x": [0, 3.14], "y": [0, 1.2], "grid": true, "labels": true }
        },
        {
          "id": "prob-graph-pib-label",
          "type": "text",
          "x": 36, "y": 552,
          "width": 580,
          "content": "Particle in a box — quantum number n = 1, 2",
          "fontSize": 15,
          "color": "rgba(196,181,253,0.60)",
          "align": "center"
        },
        {
          "id": "prob-graph-gaussian",
          "type": "graph",
          "x": 664, "y": 112,
          "width": 580, "height": 430,
          "functions": [
            {
              "expr": "exp(-x*x/2)",
              "color": "#fbbf24",
              "strokeWidth": 2.5,
              "animate": "draw-on",
              "animateDuration": 2000,
              "label": "Gaussian |\u03c8|\u00b2"
            }
          ],
          "axes": { "x": [-4, 4], "y": [0, 1.2], "grid": true, "labels": true }
        },
        {
          "id": "prob-graph-gaussian-label",
          "type": "text",
          "x": 664, "y": 552,
          "width": 580,
          "content": "Gaussian wave packet — minimum uncertainty state",
          "fontSize": 15,
          "color": "rgba(251,191,36,0.60)",
          "align": "center"
        },
        {
          "id": "prob-formula-born",
          "type": "formula",
          "x": 320, "y": 610,
          "width": 640, "height": 70,
          "latex": "P(a,b) = \\int_a^b |\\Psi(x,t)|^2 \\, dx",
          "fontSize": 26,
          "color": "rgba(241,245,249,0.85)",
          "animation": { "enter": "fade-up", "duration": 560, "delay": 300, "step": 0 }
        }
      ]
    },

    {
      "id": "orbital",
      "background": "#0f172a",
      "fx": ["aurora-wave", "constellation"],
      "notes": "3D orbital probability — viridis surface with orbiting camera.",
      "elements": [
        {
          "id": "orbital-title",
          "type": "text",
          "x": 80, "y": 38,
          "width": 760,
          "content": "Atomic Orbital Probability",
          "fontSize": 42,
          "fontWeight": "bold",
          "color": "#f1f5f9",
          "animation": { "enter": "blur-zoom", "duration": 750, "step": 0 }
        },
        {
          "id": "orbital-graph-3d",
          "type": "graph",
          "x": 160, "y": 95,
          "width": 960, "height": 555,
          "mode": "3d",
          "functions": [{ "expr": "exp(-(x*x+y*y)/4) * cos(x) * cos(y)" }],
          "surface": {
            "expr": "exp(-(x*x+y*y)/4) * cos(x) * cos(y)",
            "colorMap": "viridis",
            "resolution": 80
          },
          "axes": { "x": [-6, 6], "y": [-6, 6], "grid": true },
          "zAxis": [-1, 1],
          "camera": {
            "distance": 14,
            "phi": 0.9,
            "theta": 0.6,
            "orbit": true,
            "orbitSpeed": 0.5
          }
        },
        {
          "id": "orbital-caption",
          "type": "text",
          "x": 160, "y": 662,
          "width": 960,
          "content": "Probability amplitude |\u03c8(\u2019r)|² for a hydrogen-like orbital — surface height encodes probability density",
          "fontSize": 15,
          "color": "rgba(196,181,253,0.55)",
          "align": "center",
          "animation": { "enter": "fade-up", "duration": 500, "delay": 400, "step": 0 }
        },
        {
          "id": "orbital-orb-accent",
          "type": "circle",
          "x": 1200, "y": 640,
          "radius": 60,
          "fill": "#c4b5fd",
          "opacity": 0.12,
          "animation": { "enter": "scale-in", "duration": 700, "step": 0 }
        }
      ]
    },

    {
      "id": "uncertainty",
      "background": "#0f172a",
      "fx": ["bokeh-float"],
      "notes": "Heisenberg uncertainty: central formula, blur-reveal explanation, two extended relations.",
      "elements": [
        {
          "id": "uncertainty-title",
          "type": "text",
          "x": 80, "y": 38,
          "width": 800,
          "content": "The Uncertainty Principle",
          "fontSize": 42,
          "fontWeight": "bold",
          "color": "#f1f5f9",
          "animation": { "enter": "rise-in", "duration": 700, "step": 0 }
        },
        {
          "id": "uncertainty-glass",
          "type": "rect",
          "x": 60, "y": 108,
          "width": 1160, "height": 200,
          "fill": "rgba(196,181,253,.07)",
          "stroke": "rgba(196,181,253,.22)",
          "strokeWidth": 1,
          "radius": 22,
          "animation": { "enter": "fade-up", "duration": 600, "delay": 140, "step": 0 }
        },
        {
          "id": "uncertainty-main-formula",
          "type": "formula",
          "x": 90, "y": 148,
          "width": 1100, "height": 100,
          "latex": "\\Delta x \\cdot \\Delta p \\geq \\frac{\\hbar}{2}",
          "fontSize": 48,
          "color": "#c4b5fd",
          "animation": { "enter": "scale-in", "duration": 700, "delay": 260, "step": 0 }
        },
        {
          "id": "uncertainty-explanation",
          "type": "animatedText",
          "x": 80, "y": 345,
          "width": 1100,
          "content": "We cannot simultaneously know both the exact position and momentum of a particle — this is not a limitation of our instruments, but a fundamental property of nature.",
          "fontSize": 21,
          "color": "rgba(241,245,249,0.72)",
          "lineHeight": 1.55,
          "textAnimation": { "name": "blur-reveal", "stagger": 26, "duration": 700 },
          "animation": { "enter": "fade-up", "duration": 600, "step": 1 }
        },
        {
          "id": "uncertainty-formula-energy",
          "type": "formula",
          "x": 90, "y": 510,
          "width": 500, "height": 80,
          "latex": "\\Delta E \\cdot \\Delta t \\geq \\frac{\\hbar}{2}",
          "fontSize": 28,
          "color": "#f9a8d4",
          "animation": { "enter": "fade-up", "duration": 520, "delay": 80, "step": 2 }
        },
        {
          "id": "uncertainty-formula-robertson",
          "type": "formula",
          "x": 640, "y": 510,
          "width": 580, "height": 80,
          "latex": "\\sigma_A \\sigma_B \\geq \\frac{1}{2} \\left| \\langle [\\hat{A}, \\hat{B}] \\rangle \\right|",
          "fontSize": 26,
          "color": "#fbbf24",
          "animation": { "enter": "fade-up", "duration": 520, "delay": 180, "step": 2 }
        },
        {
          "id": "uncertainty-label-robertson",
          "type": "text",
          "x": 640, "y": 608,
          "width": 580,
          "content": "Robertson generalization — any two observables",
          "fontSize": 14,
          "color": "rgba(251,191,36,0.50)",
          "animation": { "enter": "fade-up", "duration": 400, "delay": 280, "step": 2 }
        }
      ]
