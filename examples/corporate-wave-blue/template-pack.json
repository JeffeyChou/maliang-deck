  "guidance": {
    "summary": "Use a clean white canvas, left-aligned Inter typography, blue accent line under titles, subtle gray dividers, and optional abstract blue wave artwork. Keep content modular across one-column, two-column, three-column, media, gallery, table/chart, data, dark section, and centered closing slides.",
    "outline": [
      "Build decks around concise sections with one visual purpose per slide.",
      "Reserve dark navy slides for section dividers or high-emphasis moments.",
      "Use the extracted system slides as an internal specification when extending the template."
    ],
    "deckPlan": [
      "Start with title-cover.",
      "Use one-column/two-column/multi-column for narrative content.",
      "Use chart-table and data-text-image for evidence.",
      "End with centered closing or summary guidance."
    ],
    "slideDsl": [
      "Canvas is 1280x720.",
      "Use Inter for all text.",
      "Titles are left-aligned with a short blue underline.",
      "Footer convention: company name bottom-left and slide number bottom-right.",
      "Use primary blue for active/header elements, grays for structure, and accents only for status/category markers."
    ]
