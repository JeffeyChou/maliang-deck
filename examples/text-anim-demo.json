{
  "meta": {
    "title": "Text Animation & Math Viz Demo",
    "theme": "minimal-white",
    "canvas": { "width": 1280, "height": 720 }
  },
  "slides": [
    {
      "id": "slide-stagger-char",
      "elements": [
        {
          "type": "text",
          "id": "title-1",
          "x": 100,
          "y": 50,
          "width": 1080,
          "fontSize": 28,
          "fontWeight": "bold",
          "content": "Stagger Effect — Per Character (forward)",
          "color": "#666",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "animatedText",
          "id": "stagger-char-fwd",
          "x": 100,
          "y": 180,
          "width": 1080,
          "fontSize": 52,
          "fontWeight": "bold",
          "color": "#1a1a2e",
          "content": "Hello, Maliang Deck!",
          "textAnimation": {
            "name": "stagger",
            "splitMode": "char",
            "stagger": 40,
            "direction": "forward",
            "duration": 500,
            "easing": "easeOutCubic"
          }
        },
        {
          "type": "animatedText",
          "id": "stagger-char-center",
          "x": 100,
          "y": 320,
          "width": 1080,
          "fontSize": 44,
          "fontWeight": "bold",
          "color": "#e94560",
          "content": "Center Burst!",
          "textAnimation": {
            "name": "stagger",
            "splitMode": "char",
            "stagger": 30,
            "direction": "center",
            "duration": 400
          }
        },
        {
          "type": "animatedText",
          "id": "stagger-char-random",
          "x": 100,
          "y": 450,
          "width": 1080,
          "fontSize": 40,
          "color": "#4a90d9",
          "content": "Random reveal order creates surprise",
          "textAnimation": {
            "name": "stagger",
            "splitMode": "char",
            "stagger": 25,
            "direction": "random",
            "duration": 500,
            "easing": "easeOutElastic"
          }
        }
      ]
    },
    {
      "id": "slide-stagger-word",
      "elements": [
        {
          "type": "text",
          "id": "title-2",
          "x": 100,
          "y": 50,
          "width": 1080,
          "fontSize": 28,
          "fontWeight": "bold",
          "content": "Stagger Effect — Per Word",
          "color": "#666",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "animatedText",
          "id": "stagger-word-fwd",
          "x": 100,
          "y": 180,
          "width": 1080,
          "fontSize": 36,
          "color": "#1a1a2e",
          "content": "Each word appears one by one with smooth easing",
          "textAnimation": {
            "name": "stagger",
            "splitMode": "word",
            "stagger": 150,
            "direction": "forward",
            "duration": 600
          }
        },
        {
          "type": "animatedText",
          "id": "stagger-word-edges",
          "x": 100,
          "y": 320,
          "width": 1080,
          "fontSize": 36,
          "fontWeight": "bold",
          "color": "#6c5ce7",
          "content": "Words from edges converge to center",
          "textAnimation": {
            "name": "stagger",
            "splitMode": "word",
            "stagger": 200,
            "direction": "edges",
            "duration": 500
          }
        },
        {
          "type": "animatedText",
          "id": "stagger-word-backward",
          "x": 100,
          "y": 460,
          "width": 1080,
          "fontSize": 32,
          "color": "#00b894",
          "content": "Reverse order reveals the punchline first",
          "textAnimation": {
            "name": "stagger",
            "splitMode": "word",
            "stagger": 180,
            "direction": "backward",
            "duration": 500
          }
        }
      ]
    },
    {
      "id": "slide-typewriter",
      "elements": [
        {
          "type": "text",
          "id": "title-3",
          "x": 100,
          "y": 50,
          "width": 1080,
          "fontSize": 28,
          "fontWeight": "bold",
          "content": "Typewriter Effect",
          "color": "#666",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "animatedText",
          "id": "typewriter-code",
          "x": 100,
          "y": 180,
          "width": 1080,
          "fontSize": 26,
          "fontFamily": "JetBrains Mono, monospace",
          "color": "#0f0f23",
          "content": "const deck = await maliang.create({ theme: 'neon-glass-dark' });",
          "textAnimation": {
            "name": "typewriter",
            "stagger": 45
          }
        },
        {
          "type": "animatedText",
          "id": "typewriter-prose",
          "x": 100,
          "y": 320,
          "width": 1080,
          "fontSize": 32,
          "color": "#2d3436",
          "content": "The typewriter effect evokes nostalgia and draws attention...",
          "textAnimation": {
            "name": "typewriter",
            "stagger": 55
          }
        },
        {
          "type": "animatedText",
          "id": "typewriter-fast",
          "x": 100,
          "y": 460,
          "width": 1080,
          "fontSize": 28,
          "fontFamily": "JetBrains Mono, monospace",
          "color": "#e17055",
          "content": "$ npm install @maliang-deck/cli --global",
          "textAnimation": {
            "name": "typewriter",
            "stagger": 30
          }
        }
      ]
    },
    {
      "id": "slide-wave",
      "elements": [
        {
          "type": "text",
          "id": "title-4",
          "x": 100,
          "y": 50,
          "width": 1080,
          "fontSize": 28,
          "fontWeight": "bold",
          "content": "Wave Effect (Continuous Loop)",
          "color": "#666",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "animatedText",
          "id": "wave-large",
          "x": 100,
          "y": 180,
          "width": 1080,
          "fontSize": 64,
          "fontWeight": "bold",
          "color": "#e94560",
          "content": "WAVE MOTION",
          "textAnimation": {
            "name": "wave",
            "splitMode": "char",
            "stagger": 100,
            "duration": 1800
          }
        },
        {
          "type": "animatedText",
          "id": "wave-words",
          "x": 100,
          "y": 350,
          "width": 1080,
          "fontSize": 36,
          "color": "#4a90d9",
          "content": "Words bobbing like boats on water",
          "textAnimation": {
            "name": "wave",
            "splitMode": "word",
            "stagger": 200,
            "duration": 2500
          }
        },
        {
          "type": "animatedText",
          "id": "wave-fast",
          "x": 100,
          "y": 500,
          "width": 1080,
          "fontSize": 42,
          "fontWeight": "bold",
          "color": "#6c5ce7",
          "content": "RAPID OSCILLATION",
          "textAnimation": {
            "name": "wave",
            "splitMode": "char",
            "stagger": 40,
            "duration": 800
          }
        }
      ]
    },
    {
      "id": "slide-formula-basic",
      "elements": [
        {
          "type": "text",
          "id": "title-5",
          "x": 100,
          "y": 50,
          "width": 1080,
          "fontSize": 28,
          "fontWeight": "bold",
          "content": "Formula Element — Static KaTeX Rendering",
          "color": "#666",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "formula",
          "id": "euler-identity",
          "x": 200,
          "y": 150,
          "width": 880,
          "height": 80,
          "fontSize": 36,
          "latex": "e^{i\\pi} + 1 = 0"
        },
        {
          "type": "formula",
          "id": "quadratic",
          "x": 200,
          "y": 270,
          "width": 880,
          "height": 80,
          "fontSize": 28,
          "latex": "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}"
        },
        {
          "type": "formula",
          "id": "integral",
          "x": 200,
          "y": 390,
          "width": 880,
          "height": 80,
          "fontSize": 28,
          "latex": "\\int_{-\\infty}^{\\infty} e^{-x^2} \\, dx = \\sqrt{\\pi}"
        },
        {
          "type": "formula",
          "id": "matrix",
          "x": 200,
          "y": 510,
          "width": 880,
          "height": 120,
          "fontSize": 24,
          "latex": "\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix} \\begin{pmatrix} x \\\\ y \\end{pmatrix} = \\begin{pmatrix} ax + by \\\\ cx + dy \\end{pmatrix}"
        }
      ]
    },
    {
      "id": "slide-formula-steps",
      "elements": [
        {
          "type": "text",
          "id": "title-6",
          "x": 100,
          "y": 50,
          "width": 1080,
          "fontSize": 28,
          "fontWeight": "bold",
          "content": "Formula Derivation Steps (click → to advance)",
          "color": "#666",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "formula",
          "id": "derivation-exp",
          "x": 150,
          "y": 200,
          "width": 980,
          "height": 100,
          "fontSize": 28,
          "latex": "\\frac{d}{dx} e^x = e^x",
          "steps": [
            { "latex": "\\frac{d}{dx} e^x = \\lim_{h \\to 0} \\frac{e^{x+h} - e^x}{h}" },
            { "latex": "= \\lim_{h \\to 0} \\frac{e^x \\cdot e^h - e^x}{h}" },
            { "latex": "= e^x \\cdot \\lim_{h \\to 0} \\frac{e^h - 1}{h}" },
            { "latex": "= e^x \\cdot 1 = e^x" }
          ],
          "stepTrigger": "click"
        },
        {
          "type": "formula",
          "id": "series-taylor",
          "x": 150,
          "y": 420,
          "width": 980,
          "height": 100,
          "fontSize": 24,
          "latex": "e^x = \\sum_{n=0}^{\\infty} \\frac{x^n}{n!} = 1 + x + \\frac{x^2}{2!} + \\frac{x^3}{3!} + \\cdots"
        }
      ]
    },
    {
      "id": "slide-graph-trig",
      "elements": [
        {
          "type": "text",
          "id": "title-7",
          "x": 100,
          "y": 30,
          "width": 1080,
          "fontSize": 28,
          "fontWeight": "bold",
          "content": "Graph Element — Trigonometric Functions",
          "color": "#666",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "graph",
          "id": "trig-graph",
          "x": 80,
          "y": 80,
          "width": 1120,
          "height": 580,
          "functions": [
            { "expr": "sin(x)", "color": "#e94560", "strokeWidth": 2.5, "animate": "draw-on", "animateDuration": 2000, "label": "sin(x)" },
            { "expr": "cos(x)", "color": "#4a90d9", "strokeWidth": 2.5, "animate": "draw-on", "animateDuration": 2000, "label": "cos(x)" }
          ],
          "axes": {
            "x": [-6.3, 6.3],
            "y": [-1.5, 1.5],
            "grid": true,
            "labels": true
          }
        }
      ]
    },
    {
      "id": "slide-graph-poly",
      "elements": [
        {
          "type": "text",
          "id": "title-8",
          "x": 100,
          "y": 30,
          "width": 1080,
          "fontSize": 28,
          "fontWeight": "bold",
          "content": "Graph Element — Polynomial & Exponential",
          "color": "#666",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "graph",
          "id": "poly-graph",
          "x": 80,
          "y": 80,
          "width": 1120,
          "height": 580,
          "functions": [
            { "expr": "x*x", "color": "#6c5ce7", "strokeWidth": 2.5, "animate": "draw-on", "animateDuration": 1500, "label": "x²" },
            { "expr": "x*x*x / 10", "color": "#00b894", "strokeWidth": 2, "animate": "draw-on", "animateDuration": 2000, "label": "x³/10" },
            { "expr": "exp(x/2)", "color": "#e17055", "strokeWidth": 2, "animate": "draw-on", "animateDuration": 2500, "label": "e^(x/2)" }
          ],
          "axes": {
            "x": [-5, 5],
            "y": [-5, 10],
            "grid": true,
            "labels": true
          }
        }
      ]
    }
  ]
}
