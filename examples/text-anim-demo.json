    {
      "id": "slide-formula-basic",
      "elements": [
        {
          "type": "text",
          "id": "title-5",
          "x": 100,
          "y": 50,
          "width": 1080,
          "fontSize": 28,
          "fontWeight": "bold",
          "content": "Formula Element — Static KaTeX Rendering",
          "color": "#666",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "formula",
          "id": "euler-identity",
          "x": 200,
          "y": 150,
          "width": 880,
          "height": 80,
          "fontSize": 36,
          "latex": "e^{i\\pi} + 1 = 0"
        },
        {
          "type": "formula",
          "id": "quadratic",
          "x": 200,
          "y": 270,
          "width": 880,
          "height": 80,
          "fontSize": 28,
          "latex": "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}"
        },
        {
          "type": "formula",
          "id": "integral",
          "x": 200,
          "y": 390,
          "width": 880,
          "height": 80,
          "fontSize": 28,
          "latex": "\\int_{-\\infty}^{\\infty} e^{-x^2} \\, dx = \\sqrt{\\pi}"
        },
        {
          "type": "formula",
          "id": "matrix",
          "x": 200,
          "y": 510,
          "width": 880,
          "height": 120,
          "fontSize": 24,
          "latex": "\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix} \\begin{pmatrix} x \\\\ y \\end{pmatrix} = \\begin{pmatrix} ax + by \\\\ cx + dy \\end{pmatrix}"
        }
      ]
    },
    {
      "id": "slide-formula-steps",
      "elements": [
        {
          "type": "text",
          "id": "title-6",
          "x": 100,
          "y": 50,
          "width": 1080,
          "fontSize": 28,
          "fontWeight": "bold",
          "content": "Formula Derivation Steps (click → to advance)",
          "color": "#666",
          "animation": { "enter": "fade-up", "step": 0 }
        },
        {
          "type": "formula",
          "id": "derivation-exp",
          "x": 150,
          "y": 200,
          "width": 980,
          "height": 100,
          "fontSize": 28,
          "latex": "\\frac{d}{dx} e^x = e^x",
          "steps": [
            { "latex": "\\frac{d}{dx} e^x = \\lim_{h \\to 0} \\frac{e^{x+h} - e^x}{h}" },
            { "latex": "= \\lim_{h \\to 0} \\frac{e^x \\cdot e^h - e^x}{h}" },
            { "latex": "= e^x \\cdot \\lim_{h \\to 0} \\frac{e^h - 1}{h}" },
            { "latex": "= e^x \\cdot 1 = e^x" }
          ],
          "stepTrigger": "click"
        },
        {
          "type": "formula",
          "id": "series-taylor",
          "x": 150,
          "y": 420,
          "width": 980,
          "height": 100,
          "fontSize": 24,
          "latex": "e^x = \\sum_{n=0}^{\\infty} \\frac{x^n}{n!} = 1 + x + \\frac{x^2}{2!} + \\frac{x^3}{3!} + \\cdots"
        }
      ]
    },
